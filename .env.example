# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
# generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Discord OAuth2 (https://discord.com/developers/applications) ---
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin ---
# Password cadangan/darurat untuk /admin/login (bypass). Gunakan string panjang & acak.
ADMIN_PANEL_PASSWORD=
# Discord ID yang otomatis mendapat role Owner saat login pertama
OWNER_DISCORD_ID=
